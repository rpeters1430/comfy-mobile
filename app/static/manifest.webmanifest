{
  "id": "/",
  "name": "Image Studio Mobile",
  "short_name": "Image Studio",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#121318",
  "theme_color": "#121318",
  "icons": [
    {"src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "shortcuts": [
    {"name": "New image", "short_name": "Create", "url": "/?tab=create", "icons": [{"src": "/icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Gallery", "short_name": "Gallery", "url": "/?tab=gallery", "icons": [{"src": "/icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Queue", "short_name": "Queue", "url": "/?tab=queue", "icons": [{"src": "/icon-192.png", "sizes": "192x192", "type": "image/png"}]}
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"files": [{"name": "images", "accept": ["image/*"]}]}
  }
}
